{
  "name": "@poolse/react-native-calls",
  "version": "0.4.5",
  "description": "Native call core for poolse — Kotlin/Swift calling engine with a thin React Native bridge. Ring, answer and carry audio with the app killed and the phone locked.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "ios/Core",
    "ios/Platform",
    "ios/Module",
    "ios/PoolseCalls.podspec",
    "!ios/CoreTests",
    "!**/.build",
    "expo-module.config.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo-modules-core": "*",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0"
  }
}
