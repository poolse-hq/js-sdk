require 'json'

package = JSON.parse(File.read(File.join(__dir__, '..', 'package.json')))

# LiveKit's Swift SDK (and its LiveKitUniFFI / collections dependencies)
# is no longer published to CocoaPods trunk: it lives in LiveKit's own
# spec repo. A podspec cannot declare a source, and the host's Podfile is
# generated by `expo prebuild`, so instead of asking every host to add
#
#     source 'https://cdn.cocoapods.org/'
#     source 'https://github.com/livekit/podspecs.git'
#
# we append LiveKit's spec repo to the resolver's sources while this
# podspec is loaded (autolinking evaluates it inside `pod install`).
# Trunk stays first, so every other pod resolves exactly as before.
# Opt out with POOLSE_CALLS_NO_LIVEKIT_SOURCE=1 (then add the lines above).
LIVEKIT_SPECS_SOURCE = 'https://github.com/livekit/podspecs.git'
if ENV['POOLSE_CALLS_NO_LIVEKIT_SOURCE'] != '1' &&
   defined?(Pod::Installer::Analyzer) &&
   !Pod::Installer::Analyzer.method_defined?(:poolse_calls_original_sources)
  Pod::Installer::Analyzer.class_eval do
    alias_method :poolse_calls_original_sources, :sources
    def sources
      @poolse_calls_sources ||= begin
        list = poolse_calls_original_sources
        if list.any? { |s| s.respond_to?(:url) && s.url.to_s.sub(/\.git\z/, '') == LIVEKIT_SPECS_SOURCE.sub(/\.git\z/, '') }
          list
        else
          list + [Pod::Config.instance.sources_manager.find_or_create_source_with_url(LIVEKIT_SPECS_SOURCE)]
        end
      end
    end
  end
end

Pod::Spec.new do |s|
  s.name           = 'PoolseCalls'
  s.version        = package['version']
  s.summary        = package['description']
  s.description    = package['description']
  s.license        = package['license']
  s.author         = 'Torsten Labs DOO'
  s.homepage       = 'https://poolse.dev'
  s.platforms      = { :ios => '15.1' }
  s.swift_version  = '5.9'
  s.source         = { :git => 'https://github.com/poolse/poolse-js-sdk.git' }
  s.static_framework = true

  s.dependency 'ExpoModulesCore'
  # 2.15.1: LiveKitWebRTC 144.7559.10 (LKRTC-prefixed symbols in its own
  # LiveKitWebRTC.framework) — links beside react-native-webrtc's
  # WebRTC.framework without duplicate symbols. Not 2.16+: their vendored
  # nanopb headers use <pb.h> angled includes that do not resolve when
  # CocoaPods builds the pod as a static library (Expo's default).
  s.dependency 'LiveKitClient', '= 2.15.1'
  # Chat notifications plug into expo-notifications' notification-center
  # delegate fan-out (MessageNotifications.swift) instead of replacing the
  # delegate, which would break the app's own notifications.
  s.dependency 'EXNotifications'

  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    'SWIFT_COMPILATION_MODE' => 'wholemodule',
  }

  s.frameworks = 'CallKit', 'PushKit', 'AVFoundation', 'UIKit', 'UserNotifications'
  s.source_files = 'Core/**/*.swift', 'Platform/**/*.swift', 'Module/**/*.swift'
end
