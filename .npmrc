# Internal deps are declared as real semver ranges (not `workspace:*`)
# so `npm publish` produces installable tarballs -- npm does not
# understand the workspace protocol and would ship it literally,
# breaking every consumer with EUNSUPPORTEDPROTOCOL.
#
# This keeps pnpm resolving those ranges to the local packages anyway.
# Default is true on pnpm 9 and false on pnpm 10; set it so an upgrade
# doesn't silently start pulling the published copies instead.
link-workspace-packages=true
